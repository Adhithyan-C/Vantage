{
  "name": "vantage",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace @vantage/api",
    "dev:web": "npm run dev --workspace @vantage/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "scout": "npm run scout --workspace @vantage/api --",
    "llm:check": "npm run llm:check --workspace @vantage/api --"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
